{
  "name": "homeiios-react-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-mdi-icons.mjs && vite build --configLoader native && node scripts/audit-browser-bundle.mjs",
